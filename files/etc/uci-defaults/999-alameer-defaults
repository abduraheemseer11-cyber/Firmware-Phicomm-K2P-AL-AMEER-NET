#!/bin/sh
# Alameer Software - first boot defaults (runs after 99-default-settings)

LAN_IP="10.0.0.20"
LAN_MASK="255.255.255.0"
GATEWAY="10.0.0.1"        # عدّله حسب الراوتر الرئيسي
DNS="10.0.0.1"
COUNTRY=""                # مثال: IQ / SA / AE  (اتركه فارغاً لعدم التغيير)

# ---------- system / language: English ----------
uci set system.@system[0].hostname='Alameer'
uci set system.@system[0].timezone='UTC'
uci -q delete system.@system[0].zonename
uci set luci.main.lang='en'
uci set luci.main.mediaurlbase='/luci-static/material'
uci commit system
uci commit luci

# ---------- network: LAN only, static IP ----------
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_MASK"
uci set network.lan.gateway="$GATEWAY"
uci -q delete network.lan.dns
uci add_list network.lan.dns="$DNS"
uci -q delete network.lan.ip6assign
uci -q delete network.wan
uci -q delete network.wan6
uci -q delete network.globals.ula_prefix
BR=$(uci show network | sed -n "s/^network\.\([^.=]*\)\.name='br-lan'$/\1/p" | head -1)
if [ -n "$BR" ]; then
  uci -q get network.$BR.ports | grep -qw wan || uci add_list network.$BR.ports='wan'
fi
uci commit network

# ---------- DHCP / DHCPv6 / RA OFF ----------
if [ -f /etc/config/dhcp ]; then
  uci set dhcp.lan.ignore='1'
  uci set dhcp.lan.dhcpv6='disabled'
  uci set dhcp.lan.ra='disabled'
  uci set dhcp.lan.ndp='disabled'
  uci -q delete dhcp.wan
  uci commit dhcp
fi

# ---------- IPv6 OFF ----------
cat > /etc/sysctl.d/99-alameer-ipv6.conf <<EOT
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
net.ipv6.conf.lo.disable_ipv6=1
EOT

# ---------- WiFi (real settings in /etc/config/wireless) ----------
[ -s /etc/config/wireless ] || wifi config

MACSUF=$(cat /sys/class/net/eth0/address 2>/dev/null | awk -F: '{print toupper($5 $6)}')
[ -z "$MACSUF" ] && MACSUF="0000"
BASE="AL-AMEER-NET ($MACSUF)"

get_band() {
	local r="$1" b hw ch
	b=$(uci -q get wireless.$r.band); [ -n "$b" ] && { echo "$b"; return; }
	hw=$(uci -q get wireless.$r.hwmode)
	case "$hw" in 11g) echo 2g; return;; 11a) echo 5g; return;; esac
	ch=$(uci -q get wireless.$r.channel)
	case "$ch" in ''|auto|*[!0-9]*) echo 5g;; *) [ "$ch" -le 14 ] && echo 2g || echo 5g;; esac
}

for r in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	band=$(get_band $r)
	if [ "$band" = "2g" ]; then
		uci set wireless.$r.channel='4'
		uci set wireless.$r.htmode='HT20'
		uci set wireless.$r.txpower='20'
		SUF="_2G"; WDS=0
	else
		uci set wireless.$r.channel='116'
		uci set wireless.$r.htmode='VHT40'
		uci set wireless.$r.txpower='23'
		SUF="_5G"; WDS=1
	fi
	uci set wireless.$r.disabled='0'
	[ -n "$COUNTRY" ] && uci set wireless.$r.country="$COUNTRY"

	for i in $(uci show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='$r'$/\1/p"); do
		[ "$(uci -q get wireless.$i)" = "wifi-iface" ] || continue
		uci set wireless.$i.mode='ap'
		uci set wireless.$i.network='lan'
		uci set wireless.$i.ssid="${BASE}${SUF}"
		uci set wireless.$i.encryption='none'
		uci -q delete wireless.$i.key
		uci set wireless.$i.disabled='0'
		if [ "$WDS" = "1" ]; then uci set wireless.$i.wds='1'; else uci -q delete wireless.$i.wds; fi
	done
done
uci commit wireless

exit 0
