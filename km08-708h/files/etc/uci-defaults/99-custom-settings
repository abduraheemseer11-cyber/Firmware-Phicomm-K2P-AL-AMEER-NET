#!/bin/sh
# Alameer Software - KM08-708H first boot settings

LAN_IP="192.168.10.1"
LAN_MASK="255.255.255.0"
IP_FROM_MAC=1        # 1 = 192.168.10.<last MAC byte> so several APs on one LAN do not collide (0 = fixed 192.168.10.1)

# ---------------- System ----------------
uci set system.@system[0].hostname='AL-AMEER-NET-AP'
uci set system.@system[0].timezone='<+03>-3'
uci set system.@system[0].zonename='Asia/Aden'
uci commit system

# ---------------- LuCI: Arabic (fallback English), Argon theme ----------------
if ls /usr/lib/lua/luci/i18n/base.ar.* >/dev/null 2>&1 \
   || ls /www/luci-static/resources/i18n/base.ar.* >/dev/null 2>&1 \
   || (opkg list-installed 2>/dev/null | grep -q '^luci-i18n-base-ar '); then
	uci set luci.main.lang='ar'
else
	uci set luci.main.lang='en'
fi
if [ -d /www/luci-static/argon ]; then
	uci set luci.main.mediaurlbase='/luci-static/argon'
fi
uci commit luci

# ---------------- Network: bridge / pure AP ----------------
if [ "$IP_FROM_MAC" = "1" ]; then
	MAC=$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null)
	LAST=$(printf '%d' "0x$(echo "$MAC" | awk -F: '{print $6}')" 2>/dev/null)
	[ -n "$LAST" ] || LAST=1
	[ "$LAST" -lt 2 ] && LAST=$((LAST + 2))
	[ "$LAST" -gt 254 ] && LAST=254
	LAN_IP="192.168.10.$LAST"
fi
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_MASK"
uci -q delete network.lan.gateway
uci -q delete network.lan.dns
uci -q delete network.wan
uci -q delete network.wan6
uci commit network

# ---------------- DHCP / DHCPv6 / RA : OFF ----------------
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv4='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.ndp='disabled'
uci commit dhcp
for s in dnsmasq odhcpd firewall; do
	[ -x /etc/init.d/$s ] && { /etc/init.d/$s stop; /etc/init.d/$s disable; } >/dev/null 2>&1
done

# ---------------- Wireless (US, 32 dBm requested, SSIDs, hidden mesh) ----------------
if /usr/sbin/alameer-wifi 20; then
	touch /etc/alameer.wifi.done
else
	/etc/init.d/alameer-wifi enable
fi

# ---------------- Mesh failover + cron watchdog ----------------
/etc/init.d/mesh-failover enable
mkdir -p /etc/crontabs
grep -q 'mesh-failover' /etc/crontabs/root 2>/dev/null || \
	echo '* * * * * /etc/init.d/mesh-failover running >/dev/null 2>&1 || /etc/init.d/mesh-failover start' >> /etc/crontabs/root
/etc/init.d/cron enable
/etc/init.d/cron restart >/dev/null 2>&1

exit 0
