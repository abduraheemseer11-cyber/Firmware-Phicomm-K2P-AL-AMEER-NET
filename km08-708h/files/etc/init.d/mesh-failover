#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/mesh-failover.sh
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	. /etc/mesh-failover.conf 2>/dev/null
	ip link set dev "${MESH_IF:-mesh0}" nomaster 2>/dev/null
}
