CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_kt_km08-708h=y

CONFIG_VERSION_DIST="Alameer Software"
CONFIG_VERSION_MANUFACTURER="Alameer Software"
CONFIG_VERSION_PRODUCT="KT GiGA WiFi Wave2 KM08-708H"
CONFIG_VERSION_NUMBER="1.0"
CONFIG_VERSION_CODE="AL-AMEER-KM08-1.0"

# ---- LuCI + Argon + Arabic ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-opkg-ar=y
CONFIG_PACKAGE_luci-i18n-firewall-ar=y

# ---- Core networking ----
CONFIG_PACKAGE_lldpd=y
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_ip-tiny=n
CONFIG_PACKAGE_ip-full=y

# ---- Wireless: 802.11s mesh with SAE, full iw ----
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-mesh-openssl=y
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_wireless-regdb=y
