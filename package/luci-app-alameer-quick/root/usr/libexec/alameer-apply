#!/bin/sh
# Alameer Software - apply quick-programming settings from /etc/config/alameer

g() { uci -q get alameer.main."$1"; }

get_band() {
	local r="$1" b hw ch
	b=$(uci -q get wireless.$r.band); [ -n "$b" ] && { echo "$b"; return; }
	hw=$(uci -q get wireless.$r.hwmode)
	case "$hw" in 11g) echo 2g; return;; 11a) echo 5g; return;; esac
	ch=$(uci -q get wireless.$r.channel)
	case "$ch" in ''|auto|*[!0-9]*) echo 5g;; *) [ "$ch" -le 14 ] && echo 2g || echo 5g;; esac
}

type=$(g type); [ -z "$type" ] && type=ap
ipaddr=$(g ipaddr); netmask=$(g netmask)
ssid=$(g ssid); [ -z "$ssid" ] && ssid="AL-AMEER-NET"
passen=$(g wifipass_en); pass=$(g wifipass)
mesh_id=$(g mesh_id); [ -z "$mesh_id" ] && mesh_id="AL-AMEER-MESH"

if [ -n "$ipaddr" ]; then
	uci set network.lan.ipaddr="$ipaddr"
	uci set network.lan.netmask="${netmask:-255.255.255.0}"
fi

if [ "$(g vlan)" = "1" ] && [ -n "$(g vlan_id)" ]; then
	uci set network.alameer_vlan=interface
	uci set network.alameer_vlan.device="br-lan.$(g vlan_id)"
	uci set network.alameer_vlan.proto='none'
else
	uci -q delete network.alameer_vlan
fi

for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	band=$(get_band $r)
	if [ "$band" = "2g" ]; then
		ch=$(g channel2g); tx=$(g txpower2g); ht="HT20"; suf="_2G"
	else
		ch=$(g channel5g); tx=$(g txpower5g); ht=$(g htmode5g); [ -z "$ht" ] && ht="VHT40"; suf="_5G"
	fi
	uci set wireless.$r.channel="${ch:-auto}"
	uci set wireless.$r.htmode="$ht"
	[ -n "$tx" ] && uci set wireless.$r.txpower="$tx"
	uci set wireless.$r.disabled='0'

	for i in $(uci show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='$r'$/\1/p"); do
		[ "$(uci -q get wireless.$i)" = "wifi-iface" ] || continue
		uci set wireless.$i.network='lan'
		uci set wireless.$i.disabled='0'
		if [ "$type" = "mesh" ] && [ "$band" = "5g" ]; then
			uci set wireless.$i.mode='mesh'
			uci set wireless.$i.mesh_id="$mesh_id"
			uci set wireless.$i.mesh_fwding='1'
			uci -q delete wireless.$i.ssid
			uci -q delete wireless.$i.wds
			if [ "$passen" = "1" ] && [ ${#pass} -ge 8 ]; then
				uci set wireless.$i.encryption='sae'; uci set wireless.$i.key="$pass"
			else
				uci set wireless.$i.encryption='none'; uci -q delete wireless.$i.key
			fi
		else
			uci set wireless.$i.mode='ap'
			uci -q delete wireless.$i.mesh_id
			uci -q delete wireless.$i.mesh_fwding
			uci set wireless.$i.ssid="${ssid}${suf}"
			if [ "$band" = "5g" ] || [ "$type" = "wds" ]; then
				uci set wireless.$i.wds='1'
			else
				uci -q delete wireless.$i.wds
			fi
			if [ "$passen" = "1" ] && [ ${#pass} -ge 8 ]; then
				uci set wireless.$i.encryption='psk2'; uci set wireless.$i.key="$pass"
			else
				uci set wireless.$i.encryption='none'; uci -q delete wireless.$i.key
			fi
		fi
	done
done

uci commit network
uci commit wireless
exit 0
