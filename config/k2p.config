CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y
CONFIG_VERSION_DIST="Alameer Software"
CONFIG_VERSION_MANUFACTURER="Alameer Software"
CONFIG_VERSION_PRODUCT="Phicomm K2P"
CONFIG_VERSION_NUMBER="1.0"
CONFIG_VERSION_CODE="AL-AMEER-1.0"

# ---- LuCI (minimal, English only) ----
CONFIG_PACKAGE_luci=n
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-theme-bootstrap=n
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-alameer-quick=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# ---- Languages: Arabic (+ English built-in); Chinese removed ----
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-ar=y
# (luci-i18n-opkg-ar exists only on OpenWrt <= 23.05; its 24.10 name is package-manager-ar)
CONFIG_PACKAGE_luci-i18n-opkg-ar=y

CONFIG_PACKAGE_default-settings-chn=n
CONFIG_PACKAGE_luci-i18n-base-zh-cn=n

# ---- WiFi (MT7615) + mesh-capable wpad (WDS / MESH) ----
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
CONFIG_PACKAGE_wpad-openssl=n

# ---- Not needed for an Access Point (size reduction) ----
CONFIG_IPV6=n
CONFIG_PACKAGE_kmod-ipv6=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=n
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_luci-app-firewall=n
CONFIG_PACKAGE_ip6tables=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_ppp-mod-pppoe=n
CONFIG_PACKAGE_luci-proto-ppp=n
CONFIG_PACKAGE_luci-proto-ipv6=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n

# ---- Wireless regulatory data + debugging ----
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
