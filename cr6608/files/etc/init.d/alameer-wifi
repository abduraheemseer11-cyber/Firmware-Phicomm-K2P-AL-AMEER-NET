#!/bin/sh /etc/rc.common
# fallback: finish the wifi setup after boot if the radios were not ready at first boot
START=99

start() {
	[ -f /etc/alameer.wifi.done ] && { /etc/init.d/alameer-wifi disable; return 0; }
	(
		if /usr/sbin/alameer-wifi 90 --reload; then
			touch /etc/alameer.wifi.done
			/etc/init.d/alameer-wifi disable
		fi
	) >/dev/null 2>&1 &
}
