CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- Branding (image names / /etc/openwrt_release) ----
CONFIG_VERSION_DIST="Alameer Software"
CONFIG_VERSION_MANUFACTURER="Alameer Software"
CONFIG_VERSION_PRODUCT="Xiaomi Mi Router CR6608"

# ---- Web UI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-opkg-ar=y

# ---- WISP essentials ----
CONFIG_PACKAGE_lldpd=y
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wireless-regdb=y
